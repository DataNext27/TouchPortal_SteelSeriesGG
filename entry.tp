                ]
              }
            ]
          },
          "data": [
            {
              "id": "app",
              "type": "choice",
              "label": "App",
              "default": "",
              "valueChoices": []
            },
            {
              "id": "channel",
              "type": "choice",
              "label": "Channel",
              "default": "Game",
              "valueChoices": [
                "Game",
                "Chat",
                "Media",
                "Aux"
              ]
            }
          ]
        }
      ],
