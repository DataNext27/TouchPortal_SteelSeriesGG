{
  "api": 10,
  "version": 200,
  "name": "SteelSeries GG",
  "id": "steelseries-gg",
  "configuration": {
    "colorDark": "#232B32",
    "colorLight": "#272F37",
    "parentCategory": "audio"
  },
  "plugin_start_cmd": "%TP_PLUGIN_FOLDER%TPSteelSeriesGG/TPSteelSeriesGG.exe",
  "settingsDescription": "Display customization: each 'Text' setting takes two values separated by a comma, '<On text>,<Off text>' (e.g. 'MUTED,LIVE'). They only change how states are displayed on your buttons; actions and events keep the standard values.",
  "settings": [
    {
      "name": "Mute States Text",
      "default": "Muted,Unmuted",
      "type": "text",
      "readOnly": false
    },
    {
      "name": "Mix States Text",
      "default": "On,Off",
      "type": "text",
      "readOnly": false
    },
    {
      "name": "ChatMix State Text",
      "default": "Enabled,Disabled",
      "type": "text",
      "readOnly": false
    },
    {
      "name": "Audience Monitoring Text",
      "default": "Enabled,Disabled",
      "type": "text",
      "readOnly": false
    },
    {
      "name": "Audio Activity Text",
      "default": "Playing,Silent",
      "type": "text",
      "readOnly": false
    },
    {
      "name": "Connection Text",
      "default": "Connected,Disconnected",
      "type": "text",
      "readOnly": false
    }
  ],
  "categories": [
    {
      "id": "tp_steelseries-gg_sonar",
      "name": "SteelSeries GG Sonar",
      "imagepath": "%TP_PLUGIN_FOLDER%TPSteelSeriesGG/icon-24.png",
      "subCategories": [
        {
          "id": "tp_steelseries-gg_sonar.classic",
          "name": "Classic Mode"
        },
        {
          "id": "tp_steelseries-gg_sonar.streamer",
          "name": "Streamer Mode"
        }
      ],
      "actions": [
        {
          "id": "tp_steelseries-gg_switch_mode",
          "name": "Switch mode",
          "type": "communicate",
          "lines": {
            "action": [
              {
                "language": "default",
                "data": [
                  {
                    "lineFormat": "Switch Sonar mode"
                  }
                ]
              }
            ]
          },
          "data": []
        },
        {
          "id": "tp_steelseries-gg_set_mode",
          "name": "Set mode",
          "type": "communicate",
          "lines": {
            "action": [
              {
                "language": "default",
                "data": [
                  {
                    "lineFormat": "Set Sonar mode to {$mode$}"
                  }
                ]
              }
            ]
          },
          "data": [
            {
              "id": "mode",
              "type": "choice",
              "label": "Mode",
              "default": "Classic",
              "valueChoices": [
                "Classic",
                "Streamer"
              ]
            }
          ]
        },
        {
          "id": "tp_steelseries-gg_set_classic_mute",
          "name": "Mute/Unmute (Classic)",
          "subCategoryId": "tp_steelseries-gg_sonar.classic",
          "type": "communicate",
          "lines": {
            "action": [
              {
                "language": "default",
                "data": [
                  {
                    "lineFormat": "{$action$} {$channel$} (Classic)"
                  }
                ]
              }
            ]
          },
          "data": [
            {
              "id": "action",
              "type": "choice",
              "label": "Action",
              "default": "Toggle",
              "valueChoices": [
                "Toggle",
                "Mute",
                "Unmute"
              ]
            },
            {
              "id": "channel",
              "type": "choice",
              "label": "Channel",
              "default": "Master",
              "valueChoices": [
                "Master",
                "Game",
                "Chat",
                "Media",
                "Aux",
                "Mic"
              ]
            }
          ]
        },
        {
          "id": "tp_steelseries-gg_set_streamer_mute",
          "name": "Mute/Unmute (Streamer)",
          "subCategoryId": "tp_steelseries-gg_sonar.streamer",
          "type": "communicate",
          "lines": {
            "action": [
              {
                "language": "default",
                "data": [
                  {
                    "lineFormat": "{$action$} {$channel$} on {$mix$} mix"
                  }
                ]
              }
            ]
          },
          "data": [
            {
              "id": "action",
              "type": "choice",
              "label": "Action",
              "default": "Toggle",
              "valueChoices": [
                "Toggle",
                "Mute",
                "Unmute"
              ]
            },
            {
              "id": "channel",
              "type": "choice",
              "label": "Channel",
              "default": "Master",
              "valueChoices": [
                "Master",
                "Game",
                "Chat",
                "Media",
                "Aux",
                "Mic"
              ]
            },
            {
              "id": "mix",
              "type": "choice",
              "label": "Mix",
              "default": "Personal",
              "valueChoices": [
                "Personal",
                "Stream"
              ]
            }
          ]
        },
        {
          "id": "tp_steelseries-gg_set_config",
          "name": "Set channel config",
          "type": "communicate",
          "lines": {
            "action": [
              {
                "language": "default",
                "data": [
                  {
                    "lineFormat": "Set {$channel$} config to {$config$}"
                  }
                ]
              }
            ]
          },
          "data": [
            {
              "id": "channel",
              "type": "choice",
              "label": "Channel",
              "default": "Game",
              "valueChoices": [
                "Game",
                "Chat",
                "Media",
                "Aux",
                "Mic"
              ]
            },
            {
              "id": "config",
              "type": "choice",
              "label": "Config",
              "default": "",
              "valueChoices": []
            }
          ]
        },
        {
          "id": "tp_steelseries-gg_set_classic_device",
          "name": "Set device (Classic)",
          "subCategoryId": "tp_steelseries-gg_sonar.classic",
          "type": "communicate",
          "lines": {
            "action": [
              {
                "language": "default",
                "data": [
                  {
                    "lineFormat": "Set {$channel$} device to {$device$}"
                  }
                ]
              }
            ]
          },
          "data": [
            {
              "id": "channel",
              "type": "choice",
              "label": "Channel",
              "default": "Game",
              "valueChoices": [
                "Game",
                "Chat",
                "Media",
                "Aux",
                "Mic"
              ]
            },
            {
              "id": "device",
              "type": "choice",
              "label": "Device",
              "default": "",
              "valueChoices": []
            }
          ]
        },
        {
          "id": "tp_steelseries-gg_set_streamer_device",
          "name": "Set device (Streamer)",
          "subCategoryId": "tp_steelseries-gg_sonar.streamer",
          "type": "communicate",
          "lines": {
            "action": [
              {
                "language": "default",
                "data": [
                  {
                    "lineFormat": "Set {$target$} device to {$device$}"
                  }
                ]
              }
            ]
          },
          "data": [
            {
              "id": "target",
              "type": "choice",
              "label": "Target",
              "default": "Personal Mix",
              "valueChoices": [
                "Personal Mix",
                "Stream Mix",
                "Streamer Mic"
              ]
            },
            {
              "id": "device",
              "type": "choice",
              "label": "Device",
              "default": "",
              "valueChoices": []
            }
          ]
        },
        {
          "id": "tp_steelseries-gg_set_mix",
          "name": "Toggle channel on mix",
          "subCategoryId": "tp_steelseries-gg_sonar.streamer",
          "type": "communicate",
          "lines": {
            "action": [
              {
                "language": "default",
                "data": [
                  {
                    "lineFormat": "{$action$} {$channel$} on {$mix$} mix"
                  }
                ]
              }
            ]
          },
          "data": [
            {
              "id": "action",
              "type": "choice",
              "label": "Action",
              "default": "Toggle",
              "valueChoices": [
                "Toggle",
                "Enable",
                "Disable"
              ]
            },
            {
              "id": "channel",
              "type": "choice",
              "label": "Channel",
              "default": "Game",
              "valueChoices": [
                "Game",
                "Chat",
                "Media",
                "Aux",
                "Mic"
              ]
            },
            {
              "id": "mix",
              "type": "choice",
              "label": "Mix",
              "default": "Personal",
              "valueChoices": [
                "Personal",
                "Stream"
              ]
            }
          ]
        },
        {
          "id": "tp_steelseries-gg_set_audience_monitoring",
          "name": "Toggle audience monitoring",
          "subCategoryId": "tp_steelseries-gg_sonar.streamer",
          "type": "communicate",
          "lines": {
            "action": [
              {
                "language": "default",
                "data": [
                  {
                    "lineFormat": "{$action$} audience monitoring"
                  }
                ]
              }
            ]
          },
          "data": [
            {
              "id": "action",
              "type": "choice",
              "label": "Action",
              "default": "Toggle",
              "valueChoices": [
                "Toggle",
                "Enable",
                "Disable"
              ]
            }
          ]
        },
        {
          "id": "tp_steelseries-gg_route_active_window",
          "name": "Route active window",
          "type": "communicate",
          "lines": {
            "action": [
              {
                "language": "default",
                "data": [
                  {
                    "lineFormat": "Route active window to {$channel$}"
                  }
                ]
              }
            ]
          },
          "data": [
            {
              "id": "channel",
              "type": "choice",
              "label": "Channel",
              "default": "Game",
              "valueChoices": [
                "Game",
                "Chat",
                "Media",
                "Aux"
              ]
            }
          ]
        },
        {
          "id": "tp_steelseries-gg_route_app",
          "name": "Route application",
          "type": "communicate",
          "lines": {
            "action": [
              {
                "language": "default",
                "data": [
                  {
                    "lineFormat": "Route {$app$} to {$channel$}"
