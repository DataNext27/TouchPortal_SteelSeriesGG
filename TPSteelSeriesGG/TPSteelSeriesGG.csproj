<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <OutputType>Exe</OutputType>
        <TargetFramework>net8.0</TargetFramework>
        <RollForward>LatestMajor</RollForward>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <RootNamespace>TPSteelSeriesGG</RootNamespace>
        <RuntimeIdentifier>win-x64</RuntimeIdentifier>
        <SelfContained>true</SelfContained>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="Steelseries-NET-API" Version="2.0.0-alpha.1" />
        <PackageReference Include="TouchPortal-CS-API" Version="1.47.2" />
        <PackageReference Include="Microsoft.Extensions.Logging.Console" Version="10.0.11" />
    </ItemGroup>

    <ItemGroup>
        <Content Include="entry.tp" CopyToOutputDirectory="PreserveNewest" />
    </ItemGroup>
    
</Project>