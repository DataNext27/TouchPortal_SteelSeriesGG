<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <OutputType>Exe</OutputType>
        <TargetFramework>net10.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <RootNamespace>TPSteelSeriesGG</RootNamespace>
        <!-- Single source of truth for the plugin version; the update checker compares it to GitHub releases. -->
        <Version>2.0.0</Version>
        <RuntimeIdentifier>win-x64</RuntimeIdentifier>
        <SelfContained>true</SelfContained>
        <ApplicationIcon>..\icon-24.ico</ApplicationIcon>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="Steelseries-NET-API" Version="2.0.0-alpha.3" />
        <PackageReference Include="TouchPortal-CS-API" Version="1.47.2" />
        <PackageReference Include="Microsoft.Extensions.Logging.Console" Version="10.0.11" />
    </ItemGroup>

    <ItemGroup>
        <Content Include="..\entry.tp" CopyToOutputDirectory="PreserveNewest" />
        <Content Include="..\icon-24.png" CopyToOutputDirectory="PreserveNewest" />
    </ItemGroup>

    <ItemGroup>
        <InternalsVisibleTo Include="TPSteelSeriesGG.Tests" />
    </ItemGroup>
    
</Project>